{
  "id": "/",
  "name": "MAYRA AI — Personal Companion",
  "short_name": "MAYRA AI",
  "description": "Your World, Your AI, Your Mayra. Intelligent Android personal AI companion powered by Google Gemini.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "theme_color": "#070410",
  "background_color": "#070410",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": {
    "client_mode": "auto"
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "MAYRA AI Android Mobile Interface"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "MAYRA AI Fullscreen Cybernetic Studio"
    }
  ],
  "shortcuts": [
    {
      "name": "Talk to Mayra",
      "short_name": "Talk",
      "description": "Start real-time voice conversation with Mayra",
      "url": "/?view=assistant",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Coding Studio",
      "short_name": "Code",
      "description": "Open full-stack code generator & HTML sandbox",
      "url": "/?view=coding",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "YouTube Music",
      "short_name": "Music",
      "description": "Discover and play curated songs and beats",
      "url": "/?view=youtube",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
